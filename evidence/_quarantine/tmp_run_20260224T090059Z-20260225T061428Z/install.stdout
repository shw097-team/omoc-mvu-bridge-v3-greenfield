167694 /bin/bash -c export CI=true DEBIAN_FRONTEND=noninteractive GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never HOMEBREW_NO_AUTO_UPDATE=1 GIT_EDITOR=: EDITOR=: VISUAL='' GIT_SEQUENCE_EDITOR=: GIT_MERGE_AUTOEDIT=no GIT_PAGER=cat PAGER=cat npm_config_yes=true PIP_NO_INPUT=1 YARN_ENABLE_IMMUTABLE_INSTALLS=false; set -euo pipefail TS_BEFORE=$(date -u +%Y%m%dT%H%M%SZ) WORKDIR="/workspaces/omoc-mvu-bridge-v3-greenfield" BASEDIR="$WORKDIR/evidence/_acceptance/tmp_run_${TS_BEFORE}" mkdir -p "$BASEDIR"  # Phase0: baseline snapshot git_rev=$(git rev-parse HEAD) git_status=$(git status --porcelain=v1) whichs=$(which -a node npm corepack || true) nodev=$(node -v || true) npmv=$(npm -v || true) corepackv=$(corepack --version 2>/dev/null || true) pre_opencode_ver=$(opencode --version 2>/dev/null || true)  cat > "$BASEDIR/phase0_baseline.txt" <<EOF TS_BEFORE: ${TS_BEFORE} GIT_HEAD: ${git_rev} GIT_STATUS: ${git_status}  WHICH: ${whichs}  NODE: ${nodev} NPM: ${npmv} COREPACK: ${corepackv} PRE_OPENCODE_VER: ${pre_opencode_ver} EOF  # Phase2: run installer in npm mode (time-bounded) INSTALL_CMD="OPENCODE_INSTALL_METHOD=npm OPENCODE_PIN=1.2.10 ./scripts/install-opencode-config.sh --pin 1.2.10" if command -v timeout >/dev/null 2>&1; then   timeout 300 bash -lc "$INSTALL_CMD" >"$BASEDIR/install.stdout" 2>"$BASEDIR/install.stderr" || installer_rc=$? else   OPENCODE_INSTALL_METHOD=npm OPENCODE_PIN=1.2.10 ./scripts/install-opencode-config.sh --pin 1.2.10 >"$BASEDIR/install.stdout" 2>"$BASEDIR/install.stderr" || installer_rc=$? fi installer_rc=${installer_rc:-0} echo "INSTALLER_RC=${installer_rc}" > "$BASEDIR/install.rc"  # Post-install checks post_opencode_ver=$(opencode --version 2>/dev/null || true) npm_integrity=$(npm view opencode-ai@1.2.10 dist.integrity 2>/dev/null || true) npm_tarball=$(npm view opencode-ai@1.2.10 dist.tarball 2>/dev/null || true) pgrep_out=$(pgrep -fa opencode || true) ps_out=$(ps -eo pid,ppid,etime,cmd | grep -E "opencode|bun|node" | grep -v grep || true)  cat > "$BASEDIR/post_checks.txt" <<EOF POST_INSTALL_OPENCODE_VER: ${post_opencode_ver} NPM_DIST_INTEGRITY: ${npm_integrity} NPM_TARBALL: ${npm_tarball} PGREP_OPENCODE: ${pgrep_out}  PS_MATCH: ${ps_out} EOF  # Locate latest evidence dir created by installer (if any) LATEST_EVDIR_NAME=$(ls -1t "$WORKDIR/evidence/_acceptance" 2>/dev/null | head -n1 || true) LATEST_EVDIR="$WORKDIR/evidence/_acceptance/${LATEST_EVDIR_NAME}" if [[ -d "$LATEST_EVDIR" ]]; then   echo "LATEST_EVDIR=${LATEST_EVDIR}" > "$BASEDIR/latest_evd_dir.txt" else   echo "LATEST_EVDIR=" > "$BASEDIR/latest_evd_dir.txt" fi  # Compute sha256 and size for files in latest evidence dir (if exists) if [[ -d "$LATEST_EVDIR" ]]; then   mkdir -p "$BASEDIR/evidence_file_hashes"   for f in "$LATEST_EVDIR"/*; do     if [[ -f "$f" ]]; then       sha=$(sha256sum "$f" | awk '{print $1}')       size=$(stat -c%s "$f" || stat -f%z "$f")       echo "$(basename "$f")  sha256:${sha}  size:${size}" >> "$BASEDIR/evidence_file_hashes/manifest.txt"     fi   done fi  # Gather git diff names (if any changes) git_diff_files=$(git diff --name-only || true)  # Create single evidence bundle (body without footer) SINGLE_BODY="$BASEDIR/single_body.txt" cat > "$SINGLE_BODY" <<'EOB' === Single Evidence Bundle (body) ===  EOB  # Append baseline cat "$BASEDIR/phase0_baseline.txt" >> "$SINGLE_BODY" echo -e "\n--- installer stdout ---\n" >> "$SINGLE_BODY" cat "$BASEDIR/install.stdout" >> "$SINGLE_BODY" 2>/dev/null || true echo -e "\n--- installer stderr ---\n" >> "$SINGLE_BODY" cat "$BASEDIR/install.stderr" >> "$SINGLE_BODY" 2>/dev/null || true echo -e "\n--- install rc ---\n" >> "$SINGLE_BODY" cat "$BASEDIR/install.rc" >> "$SINGLE_BODY" echo -e "\n--- post checks ---\n" >> "$SINGLE_BODY" cat "$BASEDIR/post_checks.txt" >> "$SINGLE_BODY"  if [[ -f "$BASEDIR/evidence_file_hashes/manifest.txt" ]]; then   echo -e "\n--- evidence dir file hashes ---\n" >> "$SINGLE_BODY"   cat "$BASEDIR/evidence_file_hashes/manifest.txt" >> "$SINGLE_BODY" fi  if [[ -n "$git_diff_files" ]]; then   echo -e "\n--- git diff (files changed) ---\n" >> "$SINGLE_BODY"   echo "$git_diff_files" >> "$SINGLE_BODY" else   echo -e "\n--- git diff: no unstaged/uncommitted changes detected ---\n" >> "$SINGLE_BODY" fi  # Compute sha256 of body and append footer BODY_SHA=$(sha256sum "$SINGLE_BODY" | awk '{print $1}') FINAL_SINGLE="$LATEST_EVDIR/single_evidence_bundle.txt" if [[ -z "$LATEST_EVDIR_NAME" || ! -d "$LATEST_EVDIR" ]]; then   # If no evidence dir created by installer, use our tmp dir   FINAL_SINGLE="$BASEDIR/single_evidence_bundle.txt" fi cp "$SINGLE_BODY" "$FINAL_SINGLE" # Append footer with sha of the body echo -e "\n--- footer: embedded txt_sha256 (sha256 of body above) ---\n" >> "$FINAL_SINGLE" echo "txt_sha256: ${BODY_SHA}" >> "$FINAL_SINGLE"  # Compute final file sha256 and size final_sha=$(sha256sum "$FINAL_SINGLE" | awk '{print $1}') final_size=$(stat -c%s "$FINAL_SINGLE" || stat -f%z "$FINAL_SINGLE")  # Echo summary to stdout for visibility cat <<EOF EVIDENCE_BUNDLE_PATH: ${FINAL_SINGLE} EVIDENCE_BUNDLE_BODY_SHA: ${BODY_SHA} EVIDENCE_BUNDLE_FINAL_SHA: ${final_sha} EVIDENCE_BUNDLE_FINAL_SIZE: ${final_size} LATEST_EVDIR: ${LATEST_EVDIR} INSTALLER_RC: ${installer_rc}  Files in ${BASEDIR}: $(ls -la "$BASEDIR" || true)  EOF 
