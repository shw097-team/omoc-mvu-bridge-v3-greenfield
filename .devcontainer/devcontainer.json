{
  "name": "OMOC-Bridge-V3-Greenfield (Solidified)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    // 1. 100% 微軟官方維護的 Python 3.12 核心，絕不翻車
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    // 2. 100% 微軟官方維護的 Node.js 20 核心，解決 OMO 底層依賴
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-vscode.vscode-typescript-next"
      ]
    }
  },
  // 3. 延遲注入 (Late Injection): delegate to a pinned, auditable script under scripts/
  // NOTE: Avoid long single-quoted bash snippets inlined here. The script will
  // perform pinned installs or record a documented exception if a remote bootstrap
  // (curl|bash) is required. See scripts/devcontainer_post_create.sh
  "postCreateCommand": "./scripts/devcontainer_post_create.sh",
  "remoteUser": "vscode"
}
