# Names-only contract for Phase 6.2 real environment (Staging/Production)
# DO NOT COMMIT any secret values. All values must come from GitHub Actions secrets or OIDC.
# This file documents REQUIRED environment variables and their purposes.

# ========== (REQ-010) GCP / Cloud Authentication ==========
# Choose ONE of the two patterns below:

# Pattern A: GitHub OIDC -> GCP Workload Identity Federation (RECOMMENDED for security)
# - No long-lived credentials stored in repo
# - Workload Identity Provider configured in GCP
# - GitHub Actions automatically mints tokens scoped to your workflow
GCP_WIF_PROVIDER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_PROJECT_ID=

# Pattern B: Service Account JSON (Less preferred; if used, must be stored as GitHub encrypted secret)
# - Base64-encoded JSON (e.g., from `base64 -w0 < sa.json`)
# - Set as GitHub secret and referenced as ${{ secrets.GCP_SA_JSON_B64 }}
# - NEVER commit the JSON or unencoded value
GCP_SA_JSON_B64=

# ========== (REQ-012) Runtime Environment Variables ==========
# Required by OMOC platform connector for check orchestration and reporting

# OMOC environment (staging, prod, or custom)
OMOC_ENV=

# OMOC platform API base URL (e.g., https://api.staging.omoc.example.com)
OMOC_API_BASE=

# OMOC project identifier (workspace/tenant-specific)
OMOC_PROJECT=

# OMOC tenant identifier (multi-tenant deployments)
OMOC_TENANT=

# Runner token for OMOC check execution (GitHub secret; workflow must not print)
OMOC_RUNNER_TOKEN=

# ========== (REQ-008 / REQ-009) Gate Enforcement ==========
# Timeout for acceptance checks (in seconds; e.g., 300 for 5 minutes)
ACCEPTANCE_TIMEOUT=

# Merge queue concurrency / cancel-in-progress controls (GitHub Actions native)
# Configured via concurrency: group in workflow, not env vars
# Leave this for reference: ensure merge_group job has explicit always() terminator
