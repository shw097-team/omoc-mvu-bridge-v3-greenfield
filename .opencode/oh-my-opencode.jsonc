{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",

  // ===== 1) 你要求的模型配置（硬寫死） =====
  "agents": {
    // (A) Sisyphus 必須 = gpt-5-mini（依你要求用裸名；由 OpenCode enabled_providers 限制到 github-copilot）
    "sisyphus": { "model": "gpt-5-mini" },

    // (B) 其他 3 個代理角色：都必須 = "github-copilot/gpt-5-mini"
    "oracle":    { "model": "github-copilot/gpt-5-mini" },
    "librarian": { "model": "github-copilot/gpt-5-mini" },
    "explore":   { "model": "github-copilot/gpt-5-mini" },

    // Prometheus/Metis：不在你指定 3 個內，但為避免它們偷用別家模型，一併釘死同一顆
    "prometheus": { "model": "github-copilot/gpt-5-mini" },
    "metis":      { "model": "github-copilot/gpt-5-mini" }
  },

  // ===== 2) 類別路由也統一到同一顆，避免分類時換模型 =====
  "categories": {
    "quick":            { "model": "github-copilot/gpt-5-mini" },
    "unspecified-low":  { "model": "github-copilot/gpt-5-mini" },
    "unspecified-high": { "model": "github-copilot/gpt-5-mini" },
    "deep":             { "model": "github-copilot/gpt-5-mini" },
    "ultrabrain":       { "model": "github-copilot/gpt-5-mini" },
    "writing":          { "model": "github-copilot/gpt-5-mini" },
    "visual-engineering": { "model": "github-copilot/gpt-5-mini" }
  },

  // ===== 3) OMOC：MCP 預設關閉（SUPPORT-only），避免未綁 TT 的外網/外部檢索 =====
  // Oh-My 內建 MCP：websearch/context7/grep_app (預設啟用) :contentReference[oaicite:14]{index=14}
  "disabled_mcps": ["websearch", "context7", "grep_app"],

  // ===== 4) Runtime fallback：關閉，避免「跑一跑突然換模型」造成不可回放 =====
  // ref: runtime_fallback options :contentReference[oaicite:15]{index=15}
  "runtime_fallback": false,

  // ===== 5) Sisyphus orchestration：保留，但必須可一鍵停用（fallback 到純 CLI） =====
  "sisyphus_agent": {
    "disabled": false,
    "planner_enabled": true,
    "replace_plan": true,
    "default_builder_enabled": false
  },

  // ===== 6) 背景任務：最小並行，避免資源飆升/不穩定 =====
  "background_task": {
    "defaultConcurrency": 3,
    "providerConcurrency": { "github-copilot": 3 },
    "modelConcurrency": { "github-copilot/gpt-5-mini": 3 }
  },

  // ===== 7) Tmux/LSP：MVU 最小集合，先關閉；要開請走 TT =====
  "tmux": { "enabled": false },
  "lsp": {}
}